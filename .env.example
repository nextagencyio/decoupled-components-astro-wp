# WordPress Configuration (decoupled-wp)
# Base URL of the WP site. WPGraphQL is at <WP_BASE_URL>/graphql and the
# spark-puck REST contract at <WP_BASE_URL>/wp-json/spark-puck/v1/*.
WP_BASE_URL=https://your-site.example.com
# Optional explicit GraphQL endpoint override (defaults to WP_BASE_URL/graphql)
# WP_GRAPHQL_URL=https://your-site.example.com/graphql
# Demo Mode (set to 'false' to use live WordPress)
PUBLIC_DEMO_MODE=true
