---
/**
 * Renders the WP component palette by delegating each component to the
 * existing Paragraph* renderers (forked from the Drupal starter — they
 * already render these exact prop shapes). spark-core exposes each
 * component as { kind, props } where props is a JSON string; we parse
 * it, dispatch on kind, and spread the props into the matching
 * component.
 *
 * The prop names already align (spark-core's normalizer camelCases to
 * match lib/types.ts). The one adaptation: spark-core gives image
 * fields as plain URL strings, while the Paragraph* components expect
 * { url } objects — we wrap those here so the renderers are untouched.
 */
import ParagraphHero from './paragraphs/ParagraphHero.astro'
import ParagraphCardGroup from './paragraphs/ParagraphCardGroup.astro'
import ParagraphSidebyside from './paragraphs/ParagraphSidebyside.astro'
import ParagraphAccordion from './paragraphs/ParagraphAccordion.astro'
import ParagraphQuote from './paragraphs/ParagraphQuote.astro'
import ParagraphPricing from './paragraphs/ParagraphPricing.astro'
import ParagraphLogoCollection from './paragraphs/ParagraphLogoCollection.astro'
import ParagraphStats from './paragraphs/ParagraphStats.astro'
import ParagraphNewsletter from './paragraphs/ParagraphNewsletter.astro'
import ParagraphText from './paragraphs/ParagraphText.astro'

import type { SparkComponent } from '@/lib/wp-client'

interface Props {
  components: SparkComponent[]
}

const { components = [] } = Astro.props

// kind → Astro component. The original four (richtext/cta/gallery/embed)
// render inline below; the rest delegate to a Paragraph* component.
const KIND_TO_COMPONENT: Record<string, any> = {
  hero: ParagraphHero,
  textblock: ParagraphText,
  cardgroup: ParagraphCardGroup,
  sidebyside: ParagraphSidebyside,
  accordion: ParagraphAccordion,
  quote: ParagraphQuote,
  pricing: ParagraphPricing,
  logocollection: ParagraphLogoCollection,
  stats: ParagraphStats,
  newsletter: ParagraphNewsletter,
}

// Wrap a string URL as the { url } object the Paragraph* components
// expect for image fields. Leaves objects / empties untouched.
function img(v: unknown): { url: string } | undefined {
  if (typeof v === 'string' && v !== '') return { url: v }
  if (v && typeof v === 'object' && 'url' in (v as any)) return v as { url: string }
  return undefined
}

// Per-kind prop adaptation: parse props JSON + wrap image fields.
function adapt(c: SparkComponent): Record<string, any> {
  let props: Record<string, any> = {}
  try {
    props = c.props ? JSON.parse(c.props) : {}
  } catch {
    props = {}
  }

  switch (c.kind) {
    case 'hero':
      props.backgroundImage = img(props.backgroundImage)
      break
    case 'sidebyside':
      props.image = img(props.image)
      break
    case 'quote':
      props.testimonials = (props.testimonials ?? []).map((t: any) => ({
        ...t,
        authorImage: img(t.authorImage),
        rating: t.rating ? Number(t.rating) : undefined,
      }))
      break
    case 'logocollection':
      props.logos = (props.logos ?? []).map((l: any) => ({ ...l, image: img(l.image) }))
      break
    case 'pricing':
      props.tiers = (props.tiers ?? []).map((t: any) => ({
        ...t,
        isFeatured: t.isFeatured === true || t.isFeatured === 'yes' || t.isFeatured === '1',
      }))
      break
  }
  return props
}
---

{components.map((c) => {
  // Original four kinds render inline (no Paragraph* equivalent).
  if (c.kind === 'richtext') {
    const p = (() => { try { return JSON.parse(c.props || '{}') } catch { return {} } })()
    return (
      <section class="section-padding bg-white">
        <div class="container-wide"><div class="prose prose-lg max-w-none" set:html={p.html ?? ''} /></div>
      </section>
    )
  }
  if (c.kind === 'cta') {
    const p = (() => { try { return JSON.parse(c.props || '{}') } catch { return {} } })()
    return (
      <section class="section-padding bg-gray-50">
        <div class="container-wide text-center">
          {p.heading && <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{p.heading}</h2>}
          {p.text && <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">{p.text}</p>}
          {p.buttonUrl && p.buttonLabel && (
            <a href={p.buttonUrl} class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-blue-600 text-white font-semibold no-underline hover:bg-blue-700">{p.buttonLabel}</a>
          )}
        </div>
      </section>
    )
  }
  if (c.kind === 'gallery') {
    const p = (() => { try { return JSON.parse(c.props || '{}') } catch { return {} } })()
    return (
      <section class="section-padding bg-white">
        <div class="container-wide">
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {(p.images ?? []).map((im: any) => <img src={im.src} alt={im.alt} loading="lazy" class="w-full h-auto rounded-lg" />)}
          </div>
        </div>
      </section>
    )
  }
  if (c.kind === 'embed') {
    const p = (() => { try { return JSON.parse(c.props || '{}') } catch { return {} } })()
    return (
      <section class="section-padding bg-white">
        <div class="container-wide"><div set:html={p.embedCode ?? ''} /></div>
      </section>
    )
  }

  // Full palette → delegate to the matching Paragraph* component.
  const Component = KIND_TO_COMPONENT[c.kind]
  if (!Component) {
    console.warn('Unknown component kind:', c.kind)
    return null
  }
  return <Component {...adapt(c)} />
})}
