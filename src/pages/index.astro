---
import SiteLayout from '@/src/layouts/SiteLayout.astro'
import DcComponents from '@/src/components/DcComponents.astro'
import SetupGuide from '@/src/components/SetupGuide.astro'
import { getClient } from '@/lib/wp-client'

let entry = null
let showSetup = false

if (!import.meta.env.WP_BASE_URL && import.meta.env.PUBLIC_DEMO_MODE === 'false') {
  showSetup = true
} else {
  const client = getClient()
  try {
    entry = await client.getEntryByPath('/')
  } catch (error) {
    console.error('Error fetching homepage:', error)
  }
  if (!entry) {
    showSetup = true
  }
}
---

<SiteLayout>
  {showSetup ? (
    <SetupGuide />
  ) : entry ? (
    <DcComponents components={entry.components ?? []} />
  ) : null}
</SiteLayout>
